# ==============================================================================
# Canonical Application URLs (Used for callbacks, payment redirects, and SEO)
# ==============================================================================
SITE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ==============================================================================
# Supabase Configuration (Database, Auth, and Storage)
# Obtain from: Supabase Dashboard > Project Settings > API
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ==============================================================================
# PayOS VietQR Payment Gateway (Server-only)
# Obtain from: https://my.payos.vn > Kênh thanh toán / API Credentials
# ==============================================================================
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"

# ==============================================================================
# Resend Transactional Email Service (Server-only)
# Obtain from: https://resend.com/api-keys
# Note: RESEND_FROM_EMAIL requires a verified domain in Resend
# ==============================================================================
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="KhoUI <noreply@yourdomain.com>"
RESEND_REPLY_TO_EMAIL="support@yourdomain.com"
